# Postgres connection
DATABASE_URL=postgresql+psycopg://jtron:jtron@localhost:5432/jtron

# Cookie signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# DGX Spark RAG WebSocket endpoint
DGX_RAG_WS_URL=ws://dgx-spark.local:8000/ws

# Cookie options
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=1209600

# CORS — comma-separated list of allowed origins for the future web UI
CORS_ORIGINS=http://localhost:5173
